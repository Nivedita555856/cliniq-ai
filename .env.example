# ── ClinIQ AI — Backend Environment Variables ─────────────────────────────────
# Copy to .env and fill in values.

# ── Groq LLM (required for AI analysis) ───────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── Vector DB: Zilliz Cloud (recommended for production) ──────────────────────
# Free tier: https://cloud.zilliz.com
# Leave blank to fall back to local Milvus (see below).
ZILLIZ_CLOUD_URI=
ZILLIZ_CLOUD_TOKEN=

# ── Vector DB: Local Milvus (used when Zilliz vars are empty) ─────────────────
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=medical_reports_final

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins, or * for open access during development.
ALLOWED_ORIGINS=*

# ── OpenAI (optional fallback LLM) ────────────────────────────────────────────
OPENAI_API_KEY=

# ── ML model config ───────────────────────────────────────────────────────────
# TEXT_MODEL=dmis-lab/biobert-v1.1   # BioBERT for text embeddings
# BATCH_SIZE=32
# TOP_K_RESULTS=5

# ── Daily Health Digest Email ──────────────────────────────────────────────────
# Gmail: create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=ClinIQ AI
SMTP_FROM=your.email@gmail.com

# App URL shown in digest emails
APP_URL=http://localhost:3000

# Digest schedule (UTC) — default 8:00 AM
DIGEST_HOUR=8
DIGEST_MINUTE=0

# ── Supabase (Auth + DB + Storage) ────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Twilio SMS ─────────────────────────────────────────────────────────────────
# Get from: twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── MSG91 (India SMS — cheaper alternative to Twilio) ─────────────────────────
# Get from: msg91.com → API → Auth Key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=CLINIQ
